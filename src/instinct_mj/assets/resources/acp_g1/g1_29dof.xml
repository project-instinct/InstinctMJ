    <!-- Joint Coulomb/viscous friction, armature and effort limits aligned with the Isaac Lab
         training asset (parkour_lab/assets/unitree.py G1_CFG, FrictionDCMotorCfg):
         frictionloss = coulomb_friction [N m], damping = viscous_friction [N m s/rad]. -->
    <joint solimplimit="0.97 0.995 0.001"/>
    <default class="collision">
      <!-- friction: Isaac ground mu=1.0 (robot body mu randomized 0.3-1.6 static / 0.3-1.2 dynamic,
           multiply-combine). priority="0" so the terrain geoms (priority 1 in the scene files)
           define the effective contact friction; condim=3 so only the sliding value is used. -->
      <geom group="4" friction="1.0 0.02 0.001" priority="0"/>
    </default>
    <default class="hip">
